// Business fields live in their own tables. Entity only provides stable IDs for attachments/comments.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum RecordKind {
  TENDER
  QUOTE
  WORK_ORDER
  INVOICE
  PERMISSION
  TASK
  TOPIC
  DOCUMENT
  TEMPLATE
  FEASIBILITY
  MEETING
  PROGRESS
  DEVELOPER
  SCHEME
}

model Organization {
  id                String               @id @default(cuid())
  name              String
  isDemo            Boolean              @default(false)
  profile           OrganizationProfile?
  users             User[]
  projects          Project[]
  entities          Entity[]
  files             File[]
  audit             Audit[]
  tenderSetup       TenderSetup?
  tenders           Tender[]
  quotations        Quotation[]
  workOrders        WorkOrder[]
  invoices          Invoice[]
  permissions       Permission[]
  tasks             Task[]
  topics            Topic[]
  documents         Document[]
  templates         Template[]
  feasibilities      Feasibility[]
  meetings          Meeting[]
  progressUpdates   ProgressUpdate[]
  developers        Developer[]
  permissionSchemes PermissionScheme[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model OrganizationProfile {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @default("")
  phone          String       @default("")
  address        String       @default("")
  gstin          String       @default("")
  website        String       @default("")
  companySize    String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model User {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id])
  email             String             @unique
  name              String
  passwordHash      String
  role              Role               @default(MEMBER)
  active            Boolean            @default(true)
  sessions          Session[]
  tenders           Tender[]
  quotations        Quotation[]
  workOrders        WorkOrder[]
  invoices          Invoice[]
  permissions       Permission[]
  tasks             Task[]
  topics            Topic[]
  documents         Document[]
  templates         Template[]
  feasibilities      Feasibility[]
  meetings          Meeting[]
  progressUpdates   ProgressUpdate[]
  developers        Developer[]
  permissionSchemes PermissionScheme[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
  @@index([userId])
}

model Project {
  id                String               @id @default(cuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id])
  name              String
  code              String
  location          String
  address           String               @default("")
  city              String               @default("Mumbai")
  state             String               @default("Maharashtra")
  society           String               @default("")
  tower             String               @default("")
  status            String               @default("Active")
  stage             String               @default("Planning")
  progress          Int                  @default(0)
  startDate         DateTime?
  targetDate        DateTime?
  description       String               @default("")
  coordinators      ProjectCoordinator[]
  archived          Boolean              @default(false)
  version           Int                  @default(1)
  tenders           Tender[]
  quotations        Quotation[]
  workOrders        WorkOrder[]
  invoices          Invoice[]
  permissions       Permission[]
  tasks             Task[]
  topics            Topic[]
  documents         Document[]
  templates         Template[]
  feasibilities      Feasibility[]
  meetings          Meeting[]
  progressUpdates   ProgressUpdate[]
  developers        Developer[]
  permissionSchemes PermissionScheme[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, archived])
}

model ProjectCoordinator {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position  Int
  name      String
  mobile    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, position])
}

/// Identity registry only: no business values or JSON. Composite keys enforce tenant and entity type.
model Entity {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  kind             RecordKind
  tender           Tender?
  quotation        Quotation?
  workOrder        WorkOrder?
  invoice          Invoice?
  permission       Permission?
  task             Task?
  topic            Topic?
  document         Document?
  template         Template?
  feasibility      Feasibility?
  meeting          Meeting?
  progressUpdate   ProgressUpdate?
  developer        Developer?
  permissionScheme PermissionScheme?
  files            File[]
  comments         Comment[]

  @@unique([id, organizationId, kind])
  @@unique([id, organizationId])
  @@index([organizationId, kind])
}

/// tenders: stable identifiers, timestamps and versions are preserved from the original records.
model Tender {
  id             String              @id
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  kind           RecordKind          @default(TENDER)
  entity         Entity              @relation(fields: [id, organizationId, kind], references: [id, organizationId, kind], onDelete: Cascade)
  projectId      String?
  project        Project?            @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assigneeId     String?
  assignee       User?               @relation(fields: [assigneeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  title          String
  reference      String?
  status         String
  priority       String              @default("Medium")
  dueDate        DateTime?
  content        String              @default("")
  amount         Decimal             @default(0) @db.Decimal(18, 2)
  total          Decimal             @default(0) @db.Decimal(18, 2)
  paid           Decimal             @default(0) @db.Decimal(18, 2)
  archived       Boolean             @default(false)
  version        Int                 @default(1)
  regulation     String              @default("33(9)")
  units          String              @default("")
  terms          String              @default("")
  unitTypes      TenderUnitType[]
  otherTerms     TenderTerm[]
  requirements   TenderRequirement[]
  quotations     Quotation[]
  invitations    Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@unique([organizationId, reference])
  @@unique([id, organizationId, kind])
  @@index([organizationId, archived, createdAt])
  @@index([projectId])
  @@index([assigneeId])
}

/// quotes: stable identifiers, timestamps and versions are preserved from the original records.
model Quotation {
  id               String       @id
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  kind             RecordKind   @default(QUOTE)
  entity           Entity       @relation(fields: [id, organizationId, kind], references: [id, organizationId, kind], onDelete: Cascade)
  projectId        String?
  project          Project?     @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assigneeId       String?
  assignee         User?        @relation(fields: [assigneeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  title            String
  reference        String?
  status           String
  priority         String       @default("Medium")
  dueDate          DateTime?
  content          String       @default("")
  amount           Decimal      @default(0) @db.Decimal(18, 2)
  total            Decimal      @default(0) @db.Decimal(18, 2)
  paid             Decimal      @default(0) @db.Decimal(18, 2)
  archived         Boolean      @default(false)
  version          Int          @default(1)
  developerName    String       @default("")
  quotedAmount     Decimal      @default(0) @db.Decimal(65, 30)
  additionalArea   Decimal      @default(0) @db.Decimal(65, 30)
  rent             Decimal      @default(0) @db.Decimal(65, 30)
  corpus           Decimal      @default(0) @db.Decimal(65, 30)
  completionMonths Int          @default(36)

  tenderId String
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@unique([organizationId, reference])
  @@unique([id, organizationId, kind])
  @@index([organizationId, archived, createdAt])
  @@index([projectId])
  @@index([assigneeId])
  @@index([tenderId])
}

/// work-orders: stable identifiers, timestamps and versions are preserved from the original records.
model WorkOrder {
  id             String          @id
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  kind           RecordKind      @default(WORK_ORDER)
  entity         Entity          @relation(fields: [id, organizationId, kind], references: [id, organizationId, kind], onDelete: Cascade)
  projectId      String?
  project        Project?        @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assigneeId     String?
  assignee       User?           @relation(fields: [assigneeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  title          String
  reference      String?
  status         String   
  priority       String          @default("Medium")
  dueDate        DateTime?
  content        String          @default("")
  amount         Decimal         @default(0) @db.Decimal(18, 2)
  total          Decimal         @default(0) @db.Decimal(18, 2)
  paid           Decimal         @default(0) @db.Decimal(18, 2)
  archived       Boolean         @default(false)
  version        Int             @default(1)
  developerName  String          @default("")
  tds            Decimal         @default(0) @db.Decimal(65, 30)
  retention      Decimal         @default(0) @db.Decimal(65, 30)
  terms          String          @default("")
  items          WorkOrderItem[]

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@unique([organizationId, reference])
  @@unique([id, organizationId, kind])
  @@index([organizationId, archived, createdAt])
  @@index([projectId])
  @@index([assigneeId])
}


  @@index([projectId])
  @@index([assigneeId])
}

/// schemes: stable identifiers, timestamps and versions are preserved from the original records.
model PermissionScheme {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  kind           RecordKind   @default(SCHEME)
  entity         Entity       @relation(fields: [id, organizationId, kind], references: [id, organizationId, kind], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assigneeId     String?
  assignee       User?        @relation(fields: [assigneeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  title          String
  reference      String?
  status         String
  priority       String       @default("Medium")
  dueDate        DateTime?
  content        String       @default("")
  amount         Decimal      @default(0) @db.Decimal(18, 2)
  total          Decimal      @default(0) @db.Decimal(18, 2)
  paid           Decimal      @default(0) @db.Decimal(18, 2)
  archived       Boolean      @default(false)
  version        Int          @default(1)
  type           String
  scheme         String
  documents      String       @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@unique([organizationId, reference])
  @@unique([id, organizationId, kind])
  @@index([organizationId, archived, createdAt])
  @@index([projectId])
  @@index([assigneeId])
}

